{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindBack",
  "version": "0.1.0",
  "identifier": "dev.mindback.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MindBack",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
